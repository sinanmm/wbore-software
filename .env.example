# ==============================================================================
# WBRE Certificate Management System - Environment Variables Template
# ==============================================================================

# PostgreSQL Database connection for Local & Coolify Deployment
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wbore?schema=public"

# Admin Authentication JWT Secret
JWT_SECRET="replace-with-a-random-32-character-secret-in-production"

# Application Base URL (Used for generating Verification QR codes & URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="production"

# Storage Settings (LOCAL or future S3/R2)
STORAGE_DRIVER="LOCAL"
STORAGE_LOCAL_DIR="./public/uploads"
